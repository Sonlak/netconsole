# NetConsole production secrets — template.
#
# SECURITY (C7, see docs/agents/16-security-audit-preprod.md):
# This file is the canonical store for production secrets. It is NEVER
# committed (see `.gitignore`). docker-compose.app.yml references
# every ${VAR:?msg} token here, and refuses to start if any var is
# missing — no more silent fallback to a guessable default.
#
# How to provision this file on the VPS:
#
#   1. SSH to the VPS as the user that owns /opt/netconsole
#      (sonnx). Run:
#         cd /opt/netconsole
#         cp secrets.env.example secrets.env
#         chmod 600 secrets.env
#         vim secrets.env   # fill in real values below
#
#   2. Generate the JWT_SECRET once, paste it into BOTH backend and
#      worker secrets.env. The compose file uses this for the worker
#      token signing too:
#         openssl rand -base64 48
#
#   3. Generate the WORKER_AUTH_TOKEN. It is a JWT with role="worker"
#      signed with the JWT_SECRET above. A short script in
#      scripts/rotate_secrets.sh builds one automatically; the
#      canonical fixture for an initial deploy:
#         scripts/rotate_secrets.sh --initial
#
#   4. NetBox tokens (NETBOX_TOKEN, NETBOX_TOKEN_NETBOX2) come from:
#         docker exec netbox-netbox python manage.py drf_create_token admin
#      paste the printed token. NETBOX_TOKEN_NETBOX2 is optional
#      (set blank if you don't run the second stack).
#
#   5. Vendor creds (LAB_SSH_*, JUNOS_REST_*, IOSXE_API_*, EOS_API_*,
#      NXOS_API_*, IOS_HTTP_*) MUST be rotated away from the lab
#      default `Admin@123` before any production cut-over. This file
#      enforces that by requiring non-empty values.
#
#   6. CORS_ORIGINS — comma-separated list, NO wildcards in prod.
#      Example for a single prod domain:
#         CORS_ORIGINS=https://netconsole.tailocbank.vn
#
#   7. NEVER commit secrets.env. The deploy.yml workflow will chmod
#      600 automatically on the VPS, but a local copy on a developer
#      laptop must remain gitignored.
#
# After every change: `docker compose up -d --force-recreate
# --no-deps backend worker` to roll fresh env into running containers.

# =============================================================================
# Auth (REQUIRED — backend refuses to start without these)
# =============================================================================
JWT_SECRET=
WORKER_AUTH_TOKEN=

# Production origin allowlist. NO `*` (compose + index.ts both reject
# wildcard in NODE_ENV=production). Comma-separated, no spaces.
CORS_ORIGINS=https://netconsole.tailocbank.vn

# Trust-proxy hops (default 1). Set to 2 if you put another LB
# (Cloudflare, AWS ALB) in front of nginx.
TRUST_PROXY_HOPS=1

# =============================================================================
# NetBox (REQUIRED if NETBOX_SYNC_INTERVAL_SECONDS > 0)
# =============================================================================
# Token from `drf_create_token admin` against the production NetBox.
NETBOX_TOKEN=
# Token for the second NetBox instance (port 8081). Leave empty if unused.
NETBOX_TOKEN_NETBOX2=

# =============================================================================
# Vendor / device credentials (REQUIRED)
# =============================================================================
# Lab SSH shared account (used by terminal + worker for command exec).
LAB_SSH_USER=netconsole
LAB_SSH_PASSWORD=

# Junos RESTCONF
JUNOS_REST_USER=netconsole
JUNOS_REST_PASSWORD=

# Cisco IOS-XE HTTPS API / RESTCONF
IOSXE_API_USER=netconsole
IOSXE_API_PASSWORD=

# Arista EOS eAPI
EOS_API_USER=netconsole
EOS_API_PASSWORD=

# Cisco NX-OS NX-API
NXOS_API_USER=netconsole
NXOS_API_PASSWORD=

# Cisco IOS (non-XE) — IOSexec HTTP
IOS_HTTP_USER=netconsole
IOS_HTTP_PASSWORD=

# =============================================================================
# Optional
# =============================================================================
# OpenAI key (assistant endpoint). Empty = assistant 503s with a clear
# error. Rotate every 90 days; alert when consumed.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# NetBox sync cadence. 0 = disabled.
NETBOX_SYNC_INTERVAL_SECONDS=300
