generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum DeviceStatus {
  MANAGED
  ONLINE
  OFFLINE
  MAINTENANCE
  UNKNOWN
}

enum JobType {
  CONNECT_TEST
  GET_CONFIG
  GET_ARP
  GET_MAC
  GET_INTERFACES
  GET_LOGS
  INTERFACE_ACTION
  MANAGED_CHECK
  DISCOVERY_PROBE
  APPLY_CONFIG
  ROLLBACK_CONFIG
}

enum JobStatus {
  PENDING
  RUNNING
  SUCCESS
  FAILED
}

enum DiscoveryScanStatus {
  PENDING
  RUNNING
  COMPLETED
  FAILED
}

enum DiscoveryResultStatus {
  PENDING
  PING_FAIL
  PROBING
  DISCOVERED
  SYNCED
  SKIPPED_EXISTS
  FAILED
}

model Device {
  id                 String       @id @default(uuid())
  site               String
  floor              String
  name               String
  ip                 String       @unique
  status             DeviceStatus @default(UNKNOWN)
  vendor             String
  model              String
  version            String
  serial             String       @unique
  description        String?
  lastPingAt         DateTime?
  lastPingMs         Int?
  lastManagedCheckAt DateTime?
  managedChecks      Json?
  manageError        String?
  uptimeSeconds      Int?
  uptimeAt           DateTime?
  jobs               Job[]
  savedConfig        DeviceSavedConfig?
  logs               DeviceLog[]
  // Append-only time series of interface counters (octets + errors).
  // Stored as cumulative 64-bit counters; the API computes in/out bps
  // by dividing the delta between two consecutive samples by the elapsed
  // time. BigInt columns because counters easily exceed 2^32 on busy uplinks.
  counterSamples     InterfaceCounterSample[]
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt
}

// One row per polled (device, interface, timestamp). Keeps raw counters so
// the bandwidth rate chart can be re-derived at any time without losing
// precision. Retention cleanup (see jobRetention.ts pattern) caps the table
// at ~24h or N rows, whichever fires first — defined in service code.
model InterfaceCounterSample {
  id            String   @id @default(uuid())
  deviceId      String
  device        Device   @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  interfaceName String
  // Cumulative counters (raw from device). Nullable when a vendor/RPC path
  // can't supply the field — we still persist what we have.
  inOctets      BigInt?
  outOctets     BigInt?
  inPackets     BigInt?
  outPackets    BigInt?
  inErrors      BigInt?
  outErrors     BigInt?
  inDiscards    BigInt?
  outDiscards   BigInt?
  inCrcErrors   BigInt?
  // Tag the source so we can debug a misbehaving fetcher later.
  source        String
  capturedAt    DateTime @default(now())

  @@index([deviceId, interfaceName, capturedAt])
  @@index([capturedAt])
}

model Job {
  id        String    @id @default(uuid())
  deviceId  String?
  device    Device?   @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  type      JobType
  status    JobStatus @default(PENDING)
  /// Job pickup priority. HIGH = Config Studio (APPLY_CONFIG, ROLLBACK_CONFIG,
  /// manual GET_CONFIG/GET_INTERFACES) — worker must skip past these before
  /// touching collection jobs. NORMAL = scheduled GET_ARP/GET_MAC/GET_CONFIG
  /// from collection intervals. Workers MUST sort by priority DESC, createdAt
  /// ASC when polling PENDING.
  priority  Int       @default(0)
  payload   Json?
  result    Json?
  error     String?
  // User who POSTed this job via /api/jobs. Workers (which also call POST
  // for DISCOVERY_PROBE/queueGen) must carry a userId in their JWT; we
  // attribute scheduler-driven jobs to the worker system user instead.
  // Nullable so the existing rows (pre-migration) keep loading.
  createdById String?
  createdBy   User?   @relation(fields: [createdById], references: [id], onDelete: SetNull)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([deviceId])
  @@index([status])
  @@index([createdById])
  @@index([deviceId, status])
  @@index([deviceId, type, status, updatedAt(sort: Desc)])
  @@index([status, priority, createdAt])
}

enum LogSeverity {
  EMERGENCY
  ALERT
  CRITICAL
  ERROR
  WARNING
  NOTICE
  INFORMATIONAL
  DEBUG
}

enum LogFacility {
  KERNEL
  USER
  MAIL
  DAEMON
  AUTHORIZATION
  SYSLOG
  NTP
  SECURITY
  CONSOLE
  LOCAL0
  LOCAL1
  LOCAL2
  LOCAL3
  LOCAL4
  LOCAL5
  LOCAL6
  LOCAL7
  PFE
  FIREWALL
  CHANGE_LOG
  INTERACTIVE_COMMANDS
  CONFLICT_LOG
  DFC
  EXTERNAL
  FTP
  PRINTER
  NEWS
  UUCP
  CLOCK
  AUTH_PRIVATE
  UNKNOWN
}

model DeviceLog {
  id          String       @id @default(uuid())
  deviceId    String?
  device      Device?      @relation(fields: [deviceId], references: [id], onDelete: SetNull)
  hostname    String
  severity    LogSeverity
  facility    LogFacility  @default(UNKNOWN)
  timestamp   DateTime
  message     String
  program     String?
  pid         Int?
  tag         String?
  jobId       String?
  receivedAt  DateTime     @default(now())

  @@index([deviceId, timestamp])
  @@index([severity, timestamp])
  @@index([timestamp])
  @@index([jobId])
}

model LogAlertRule {
  id              String       @id @default(uuid())
  name            String
  description     String?
  deviceId        String?      // null = applies to all devices
  minSeverity     LogSeverity  // matches logs >= this severity (most-severe-first)
  messagePattern  String?      // optional regex to match the message
  facility        LogFacility? // null = any facility
  enabled         Boolean      @default(true)
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
  alerts          LogAlert[]

  @@index([enabled])
  @@index([deviceId, enabled])
}

model LogAlert {
  id             String       @id @default(uuid())
  ruleId         String
  rule           LogAlertRule @relation(fields: [ruleId], references: [id], onDelete: Cascade)
  deviceId       String?
  deviceIp       String?
  severity       LogSeverity
  hostname       String
  program        String?
  message        String
  deviceLogId    String?      // nullable: syslog-UDP logs have no deviceLog row
  timestamp      DateTime
  acknowledged   Boolean      @default(false)
  acknowledgedAt DateTime?
  createdAt      DateTime     @default(now())

  @@index([ruleId, acknowledged])
  @@index([deviceId, acknowledged])
  @@index([acknowledged, createdAt])
}

model DiscoveryScan {
  id         String              @id @default(uuid())
  subnet     String
  site       String              @default("")
  floor      String              @default("")
  status     DiscoveryScanStatus @default(PENDING)
  totalHosts Int                 @default(0)
  scanned    Int                 @default(0)
  reachable  Int                 @default(0)
  discovered Int                 @default(0)
  error      String?
  results    DiscoveryResult[]
  createdAt  DateTime            @default(now())
  updatedAt  DateTime            @updatedAt
}

model DiscoveryResult {
  id          String                @id @default(uuid())
  scanId      String
  scan        DiscoveryScan         @relation(fields: [scanId], references: [id], onDelete: Cascade)
  ip          String
  status      DiscoveryResultStatus @default(PENDING)
  pingOk      Boolean               @default(false)
  pingMs      Int?
  sshOk       Boolean               @default(false)
  name        String?
  vendor      String?
  model       String?
  version     String?
  serial      String?
  description String?
  showRun     String?
  error       String?
  deviceId    String?
  createdAt   DateTime              @default(now())
  updatedAt   DateTime              @updatedAt

  @@unique([scanId, ip])
  @@index([scanId])
}

model DeviceSavedConfig {
  id                String    @id @default(uuid())
  deviceId          String    @unique
  device            Device    @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  role              String    @default("custom")
  content           String    @default("")
  committedContent  String?
  rollbackContent   String?
  committedAt       DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
}

// Vendor families for config templates
enum VendorFamily {
  JUNIPER
  CISCO
  ARISTA
  UNKNOWN
}

model ConfigTemplate {
  id          String       @id @default(uuid())
  name        String       @unique
  description String?
  content     String
  vendor      VendorFamily @default(UNKNOWN)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
}

enum UserRole {
  ADMIN
  OPERATOR
  VIEWER
}

model User {
  id                 String    @id @default(uuid())
  username           String    @unique
  email              String    @unique
  password           String    // bcrypt hashed
  role               UserRole  @default(OPERATOR)
  active             Boolean   @default(true)
  mustChangePassword Boolean   @default(false)
  lastLoginAt        DateTime?
  lastLoginIp        String?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  // Back-relation for RefreshToken. `onDelete: Cascade` because a deleted
  // user's refresh rows have no business meaning.
  refreshTokens RefreshToken[]

  // Back-relation for jobs the user created via POST /api/jobs.
  // `onDelete: SetNull` so historical jobs survive user deletion (audit
  // trail is more important than referential tidiness here).
  jobs Job[]

  // Back-relation for terminal sessions
  terminalSessions TerminalSession[]
}

// Append-only audit trail. Every mutating API request is logged here by the
// auditLog middleware in backend/src/middleware/auditLog.ts. Never delete
// rows from this table — bank auditors will ask for the full history.
model AuditLog {
  id         String   @id @default(uuid())
  userId     String?
  username   String?  // denormalised so audit stays readable after user deletion
  role       String?
  method     String
  path       String   // original URL including query string
  action     String   // route shape, e.g. "/api/jobs" or "/api/auth/users/:id"
  ip         String?
  userAgent  String?
  statusCode Int
  metadata   Json?    // bodyKeys + params + summary, never raw secrets
  createdAt  DateTime @default(now())

  @@index([userId, createdAt])
  @@index([path, createdAt])
  @@index([statusCode, createdAt])
  @@index([createdAt])
}

// ConfigAuditLog – append-only log of every successful APPLY_CONFIG job.
// Records WHO applied WHAT WHEN so the compare/history page can show
// a full audit trail, including whether the change came from the web UI
// (job had a real userId) or was a scheduled collection (worker-only).
model ConfigAuditLog {
  id          String   @id @default(uuid())
  deviceId    String
  jobId       String   @unique  // one audit row per APPLY_CONFIG job
  // The user who triggered the job. Null = scheduler/worker (CLI change).
  userId      String?
  username    String?
  // The role that was applied (core/dist/access/custom/template-xxx)
  configRole  String?
  // Full config content that was applied (the `config` field from payload)
  config      String
  // Count of individual command lines (from the `commands` result array)
  lineCount   Int      @default(0)
  // Which API path was used (eos-api / ssh-cli / junos-rest / nxos-api / etc.)
  source      String?
  // Human-readable summary of what happened
  message     String?
  createdAt   DateTime @default(now())

  @@index([deviceId, createdAt])
  @@index([deviceId])
}

// Long-lived refresh token. Access tokens (15 min) are issued alongside a
// refresh token (30 d); the frontend calls POST /api/auth/refresh to mint
// a new access token without asking the user for their password.
//
// Token shape: a 256-bit random secret hashed with SHA-256, stored as
// `tokenHash`. Only the hash is persisted — the raw token leaves the
// backend once, in the original login response.
//
// Rotation: each successful /refresh returns a NEW refresh token AND
// invalidates the previous one. Reusing a consumed token revokes the
// whole chain (a stolen old token cannot be replayed).
model RefreshToken {
  id         String    @id @default(uuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash  String    @unique
  expiresAt  DateTime
  createdAt  DateTime  @default(now())
  consumedAt DateTime? // set when /refresh replaces this row; null = still valid
  revokedAt  DateTime? // explicit logout or admin revoke
  userAgent  String?
  ip         String?

  @@index([userId, createdAt])
  @@index([expiresAt])
}

// Web SSH terminal sessions - compliance logging
model TerminalSession {
  id          String            @id @default(uuid())
  userId      String
  user        User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  deviceId    String?
  deviceIp    String?           // denormalised: stays readable after device deletion
  deviceName  String?
  hostname    String?           // device's reported hostname at session start
  startTime   DateTime          @default(now())
  endTime     DateTime?
  error       String?           // connection error message if failed
  commands    TerminalCommand[]

  @@index([userId, startTime])
  @@index([deviceId, startTime])
  @@index([startTime])
}

// Individual command + output within a terminal session
model TerminalCommand {
  id        String         @id @default(uuid())
  sessionId String
  session   TerminalSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  command   String         // raw input (passwords stripped server-side)
  output    String?        // stdout/stderr; null for password echo
  duration  Int?           // milliseconds to complete
  timestamp DateTime       @default(now())

  @@index([sessionId])
}
