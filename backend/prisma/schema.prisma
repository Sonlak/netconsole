generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum DeviceStatus {
  MANAGED
  ONLINE
  OFFLINE
  MAINTENANCE
  UNKNOWN
}

enum JobType {
  CONNECT_TEST
  GET_CONFIG
  GET_ARP
  GET_MAC
  GET_INTERFACES
  GET_LOGS
  INTERFACE_ACTION
  MANAGED_CHECK
  DISCOVERY_PROBE
  APPLY_CONFIG
  ROLLBACK_CONFIG
}

enum JobStatus {
  PENDING
  RUNNING
  SUCCESS
  FAILED
}

enum DiscoveryScanStatus {
  PENDING
  RUNNING
  COMPLETED
  FAILED
}

enum DiscoveryResultStatus {
  PENDING
  PING_FAIL
  PROBING
  DISCOVERED
  SYNCED
  SKIPPED_EXISTS
  FAILED
}

model Device {
  id                 String       @id @default(uuid())
  site               String
  floor              String
  name               String
  ip                 String       @unique
  status             DeviceStatus @default(UNKNOWN)
  vendor             String
  model              String
  version            String
  serial             String       @unique
  description        String?
  lastPingAt         DateTime?
  lastPingMs         Int?
  lastManagedCheckAt DateTime?
  managedChecks      Json?
  manageError        String?
  uptimeSeconds      Int?
  uptimeAt           DateTime?
  jobs               Job[]
  savedConfig        DeviceSavedConfig?
  logs               DeviceLog[]
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt
}

model Job {
  id        String    @id @default(uuid())
  deviceId  String?
  device    Device?   @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  type      JobType
  status    JobStatus @default(PENDING)
  payload   Json?
  result    Json?
  error     String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([deviceId])
  @@index([status])
}

enum LogSeverity {
  EMERGENCY
  ALERT
  CRITICAL
  ERROR
  WARNING
  NOTICE
  INFORMATIONAL
  DEBUG
}

enum LogFacility {
  KERNEL
  USER
  MAIL
  DAEMON
  AUTHORIZATION
  SYSLOG
  NTP
  SECURITY
  CONSOLE
  LOCAL0
  LOCAL1
  LOCAL2
  LOCAL3
  LOCAL4
  LOCAL5
  LOCAL6
  LOCAL7
  PFE
  FIREWALL
  CHANGE_LOG
  INTERACTIVE_COMMANDS
  CONFLICT_LOG
  DFC
  EXTERNAL
  FTP
  PRINTER
  NEWS
  UUCP
  CLOCK
  AUTH_PRIVATE
  UNKNOWN
}

model DeviceLog {
  id          String       @id @default(uuid())
  deviceId    String?
  device      Device?      @relation(fields: [deviceId], references: [id], onDelete: SetNull)
  hostname    String
  severity    LogSeverity
  facility    LogFacility  @default(UNKNOWN)
  timestamp   DateTime
  message     String
  program     String?
  pid         Int?
  tag         String?
  jobId       String?
  receivedAt  DateTime     @default(now())

  @@index([deviceId, timestamp])
  @@index([severity, timestamp])
  @@index([timestamp])
  @@index([jobId])
}

model LogAlertRule {
  id              String       @id @default(uuid())
  name            String
  description     String?
  deviceId        String?      // null = applies to all devices
  minSeverity     LogSeverity  // matches logs >= this severity (most-severe-first)
  messagePattern  String?      // optional regex to match the message
  facility        LogFacility? // null = any facility
  enabled         Boolean      @default(true)
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
  alerts          LogAlert[]

  @@index([enabled])
  @@index([deviceId, enabled])
}

model LogAlert {
  id             String       @id @default(uuid())
  ruleId         String
  rule           LogAlertRule @relation(fields: [ruleId], references: [id], onDelete: Cascade)
  deviceId       String?
  deviceIp       String?
  severity       LogSeverity
  hostname       String
  program        String?
  message        String
  deviceLogId    String?      // nullable: syslog-UDP logs have no deviceLog row
  timestamp      DateTime
  acknowledged   Boolean      @default(false)
  acknowledgedAt DateTime?
  createdAt      DateTime     @default(now())

  @@index([ruleId, acknowledged])
  @@index([deviceId, acknowledged])
  @@index([acknowledged, createdAt])
}

model DiscoveryScan {
  id         String              @id @default(uuid())
  subnet     String
  site       String              @default("")
  floor      String              @default("")
  status     DiscoveryScanStatus @default(PENDING)
  totalHosts Int                 @default(0)
  scanned    Int                 @default(0)
  reachable  Int                 @default(0)
  discovered Int                 @default(0)
  error      String?
  results    DiscoveryResult[]
  createdAt  DateTime            @default(now())
  updatedAt  DateTime            @updatedAt
}

model DiscoveryResult {
  id          String                @id @default(uuid())
  scanId      String
  scan        DiscoveryScan         @relation(fields: [scanId], references: [id], onDelete: Cascade)
  ip          String
  status      DiscoveryResultStatus @default(PENDING)
  pingOk      Boolean               @default(false)
  pingMs      Int?
  sshOk       Boolean               @default(false)
  name        String?
  vendor      String?
  model       String?
  version     String?
  serial      String?
  description String?
  showRun     String?
  error       String?
  deviceId    String?
  createdAt   DateTime              @default(now())
  updatedAt   DateTime              @updatedAt

  @@unique([scanId, ip])
  @@index([scanId])
}

model DeviceSavedConfig {
  id                String    @id @default(uuid())
  deviceId          String    @unique
  device            Device    @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  role              String    @default("custom")
  content           String    @default("")
  committedContent  String?
  rollbackContent   String?
  committedAt       DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
}

enum UserRole {
  ADMIN
  OPERATOR
  VIEWER
}

model User {
  id                 String    @id @default(uuid())
  username           String    @unique
  email              String    @unique
  password           String    // bcrypt hashed
  role               UserRole  @default(OPERATOR)
  active             Boolean   @default(true)
  mustChangePassword Boolean   @default(false)
  lastLoginAt        DateTime?
  lastLoginIp        String?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
}

// Append-only audit trail. Every mutating API request is logged here by the
// auditLog middleware in backend/src/middleware/auditLog.ts. Never delete
// rows from this table — bank auditors will ask for the full history.
model AuditLog {
  id         String   @id @default(uuid())
  userId     String?
  username   String?  // denormalised so audit stays readable after user deletion
  role       String?
  method     String
  path       String   // original URL including query string
  action     String   // route shape, e.g. "/api/jobs" or "/api/auth/users/:id"
  ip         String?
  userAgent  String?
  statusCode Int
  metadata   Json?    // bodyKeys + params + summary, never raw secrets
  createdAt  DateTime @default(now())

  @@index([userId, createdAt])
  @@index([path, createdAt])
  @@index([statusCode, createdAt])
  @@index([createdAt])
}
