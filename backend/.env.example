# ===========================================
# NetConsole Backend Configuration
# ===========================================
# COPY THIS FILE TO .env AND FILL IN VALUES
# NEVER COMMIT .env TO GIT
# ===========================================

# Database
DATABASE_URL="postgresql://netconsole:netconsole@localhost:5432/netconsole?schema=public"

# Server
PORT=3000

# JWT Authentication (REQUIRED - generate a secure secret)
# Generate with: openssl rand -base64 32
JWT_SECRET="CHANGE_ME_TO_A_SECURE_SECRET_AT_LEAST_32_CHARS_LONG"
JWT_EXPIRES_IN="24h"

# CORS - comma-separated list of allowed origins
# Example: CORS_ORIGINS="http://localhost:5173,https://netconsole.example.com"
CORS_ORIGINS="http://localhost:5173"

# Scheduler Intervals (Tier B — industry standard, PCI-DSS §11.5.2 friendly)
PING_INTERVAL_SECONDS=60
PING_TIMEOUT_MS=3000
MANAGED_CHECK_INTERVAL_SECONDS=600
MAC_COLLECT_INTERVAL_SECONDS=300
ARP_COLLECT_INTERVAL_SECONDS=300
INTERFACES_COLLECT_INTERVAL_SECONDS=600
CONFIG_COLLECT_INTERVAL_SECONDS=900

# Retention (days). Required when MAC/ARP interval < 60 min —
# otherwise Job table grows ~280k rows/month at 5-min sweeps.
LOG_RETENTION_DAYS=30
JOB_RETENTION_DAYS=30

# Lab SSH (for device simulation)
LAB_SSH_ENABLED=false
LAB_SSH_USER=netconsole
LAB_SSH_PASSWORD=Admin@123
LAB_SSH_PORT=22

# JUNOS REST API (for real Juniper devices)
JUNOS_REST_ENABLED=true
JUNOS_REST_SCHEME=http
JUNOS_REST_PORT=8443
JUNOS_REST_VERIFY_TLS=false
JUNOS_REST_USER=netconsole
JUNOS_REST_PASSWORD=Admin@123

# EOS eAPI (for Arista EOS devices) — fast-path, bypasses job queue
EOS_API_ENABLED=true
EOS_API_SCHEME=https
EOS_API_PORT=443
EOS_API_VERIFY_TLS=false
EOS_API_USER=netconsole
EOS_API_PASSWORD=Admin@123

# Seed Configuration (for initial setup)
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_PASSWORD=Admin@123
# SEED_DISABLED=true

# AI Assistant (NetConsole Assistant)
# Get an API key at https://platform.openai.com/api-keys
# Leave OPENAI_API_KEY empty to disable the assistant endpoint.
# gpt-4.1-mini supports OpenAI prompt caching (50% off on cached input)
# which keeps the cost around $1.5-2.5 per dev per month with 30 queries/day.
OPENAI_API_KEY=
# Model to use. Production = gpt-4.1 (full) since 2026-10-13.
# gpt-4.1-mini is fine for local dev if you want lower cost.
# Other options: gpt-4.1-mini, gpt-4o-mini.
OPENAI_MODEL=gpt-4.1-mini

# ─── NetBox (multi-instance) ──────────────────────────────────────────────────
# Either legacy single-instance (NETBOX_URL + NETBOX_TOKEN) or
# multi-instance via NETBOX_INSTANCES JSON.
#
# LEGACY (single instance):
#   NETBOX_URL=http://netbox-netbox:8080/api/
#   NETBOX_TOKEN=0123456789abcdef0123456789abcdef01234567
#
# MULTI-INSTANCE (preferred — added 2026-10-15):
#   NETBOX_INSTANCES='{"production":{"url":"http://netbox-netbox:8080/api/","token":"0123...67"},"netbox2":{"url":"http://netbox2-netbox:8080/api/","token":"fedc...98"}}'
#   NETBOX_DEFAULT_INSTANCE=production
#
# Each instance name becomes a target for the AI assistant tool
# `create_netbox_prefix`, `bulk_create_netbox_prefixes`, `copy_netbox_prefixes`,
# and the frontend page /netbox-import (Admin only).
NETBOX_URL=http://netbox-netbox:8080/api/
NETBOX_TOKEN=0123456789abcdef0123456789abcdef01234567
NETBOX_TIMEOUT_MS=15000
# To enable multi-instance, set the JSON below. Empty by default (legacy mode).
# NETBOX_INSTANCES=
# NETBOX_DEFAULT_INSTANCE=production
