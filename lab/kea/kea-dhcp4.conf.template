{
  "Dhcp4": {
    "valid-lifetime": 28800,
    "renew-timer": 14400,
    "rebind-timer": 25200,
    "interfaces-config": {
      "interfaces": [ "*" ]
    },
    "control-socket": {
      "socket-type": "unix",
      "socket-name": "/var/run/kea/kea4-ctrl-socket"
    },
    "lease-database": {
      "type": "memfile",
      "persist": true,
      "name": "/var/lib/kea/kea-leases4.csv"
    },
    "hooks-libraries": [
      {
        "library": "/usr/lib/x86_64-linux-gnu/kea/hooks/libdhcp_lease_cmds.so"
      },
      {
        "library": "/usr/lib/x86_64-linux-gnu/kea/hooks/libdhcp_ha.so",
        "parameters": {
          "high-availability": [
            {
              "this-server-name": "__THIS_SERVER_NAME__",
              "mode": "hot-standby",
              "heartbeat-delay": __KEA_HEARTBEAT_DELAY_MS__,
              "max-response-delay": __KEA_MAX_RESPONSE_DELAY_MS__,
              "max-ack-delay": __KEA_MAX_ACK_DELAY_MS__,
              "max-unacked-clients": 0,
              "auto-failover": true,
              "peers": [
                {
                  "name": "__THIS_SERVER_NAME__",
                  "url": "http://__THIS_SERVER_URL__:8001/",
                  "role": "__THIS_SERVER_ROLE__"
                },
                {
                  "name": "__KEA_PEER_NAME__",
                  "url": "__KEA_PEER_URL__",
                  "role": "__KEA_PEER_ROLE__"
                }
              ]
            }
          ]
        }
      }
    ],
    "option-data": [
      {
        "name": "domain-name-servers",
        "data": "8.8.8.8, 1.1.1.1"
      },
      {
        "name": "domain-name",
        "data": "lab.netconsole.local"
      }
    ],
    "subnet4": [],
    "loggers": [
      {
        "name": "kea-dhcp4",
        "severity": "INFO",
        "output_options": [{ "output": "stdout" }]
      },
      {
        "name": "kea-dhcp4.hooks",
        "severity": "INFO",
        "output_options": [{ "output": "stdout" }]
      }
    ]
  }
}
