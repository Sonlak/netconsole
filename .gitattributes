# Enforce LF line endings for shell scripts (Windows checkouts otherwise
# break scripts with `set -euo pipefail` parsing)
*.sh       text eol=lf
*.yml      text eol=lf
*.yaml     text eol=lf
*.json     text eol=lf
# PEM files (TLS certs, keys) must be LF or some parsers reject CRLF.
*.pem      text eol=lf
*.key      text eol=lf
*.crt      text eol=lf