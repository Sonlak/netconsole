# ===========================================
# NetConsole Frontend Configuration (dev only)
# ===========================================
# COPY THIS FILE TO .env AND FILL IN VALUES
# NEVER COMMIT .env TO GIT
# ===========================================

# Backend API proxy target for `vite dev`
# Local backend: http://localhost:3000
# Remote backend: http://<vps>:3000  (NOT recommended — just SSH in)
VITE_DEV_PROXY_TARGET=http://localhost:3000

# Optional: force API base path (if not using vite proxy)
# VITE_API_BASE=http://localhost:3000/api
