FROM node:22-bookworm-slim AS build

WORKDIR /app

COPY package.json package-lock.json* ./
# Cache mount for npm. See backend/Dockerfile for the rationale.
# On the prod path (`Dockerfile.prod`), this stage runs once per
# `package*.json` change — warm cache saves 20-30s per deploy.
# Requires BuildKit (`DOCKER_BUILDKIT=1`).
RUN --mount=type=cache,target=/root/.npm \
    npm ci

COPY . .
RUN npm run build

FROM nginx:1.27-alpine

# SECURITY (M12, see docs/agents/16-security-audit-preprod.md):
# the default nginx image ships nginx running as root. We tried
# dropping to `USER nginx` (commits 0dfc7e5..8d86614) but that
# chain surfaced FIVE separate root-vs-nginx assumptions in the
# base image (apk db, certs, /var/{cache,log,run}/*, pid file,
# plus the privileged port 443 bind that requires root or
# CAP_NET_BIND_SERVICE). Each fix surfaced the next assumption.
#
# The right long-term fix is to switch to `nginxinc/nginx-unprivileged`
# (which sets setcap cap_net_bind_service=+ep on the binary) and
# track that in a follow-up. For this commit we revert USER nginx
# so the image actually runs — the M12 defense-in-depth goal is
# sacrificed, but the security stack that actually matters (helmet,
# CSP, HSTS, fail-fast JWT, RBAC, syslog allowlist, syslog
# iptables rule, HTTPS-only, etc.) is unaffected. The nginx
# process still runs in its own container with a read-only root
# fs at runtime, no shell, and no outbound network except to the
# backend — the actual attack surface is the app code, not the
# nginx UID.
#
# What this keeps from the M12 attempt
# - Self-signed cert generated at build time (still in image, still
#   chmod 600 / chown nginx — nginx can read the key either way)
# - `mkdir` + `chown` of /var/{cache,log,run}/nginx — kept for
#   when we re-introduce USER nginx in a follow-up
# - The cert/key work — kept
#
# What this REMOVES (revert)
# - `USER nginx` directive at the end — gone

# Pre-create the runtime dirs as nginx-owned, ready for a follow-up
# that re-introduces USER nginx via the nginx-unprivileged base image.
# Right now we run as root, so the chown is a no-op for runtime but
# documents the path forward.
RUN mkdir -p \
      /var/cache/nginx \
      /var/log/nginx \
      /var/run/nginx && \
    chown -R nginx:nginx \
      /usr/share/nginx/html \
      /etc/nginx/conf.d \
      /var/cache/nginx \
      /var/log/nginx \
      /var/run/nginx

# Generate a self-signed cert at build time (1-year expiry,
# 2048-bit RSA, CN=localhost). The image boots out of the box with
# HTTPS support — for PRODUCTION, mount a real cert from
# /etc/letsencrypt/live/<domain>/ over /etc/nginx/certs/ via the
# frontend service's `volumes:` block in docker-compose.app.yml.
# Nginx reads the cert on startup, so a cert-rotation only requires
# `docker compose restart frontend` (no rebuild).
#
# `openssl` is not preinstalled in the nginx:alpine image. Install
# it for the cert generation, then keep it installed (libssl is a
# nginx runtime dep, `apk del openssl` is rejected as "breaks the
# world" — see commit 0dfc7e5 for the full discussion).
RUN apk add --no-cache openssl && \
    mkdir -p /etc/nginx/certs && \
    openssl req -x509 -nodes -days 365 -newkey rsa:2048 \
      -keyout /etc/nginx/certs/key.pem \
      -out /etc/nginx/certs/cert.pem \
      -subj "/CN=localhost/O=NetConsole-Image-Fallback" \
      -addext "subjectAltName=DNS:localhost,IP:127.0.0.1" && \
    chown -R nginx:nginx /etc/nginx/certs && \
    chmod 600 /etc/nginx/certs/key.pem /etc/nginx/certs/cert.pem

# The cert files in /etc/nginx/certs are readable by both root and
# nginx (chmod 644 for cert.pem, 600 for key.pem). When the master
# runs as root (current state), it can read both. The pid-file
# directive is removed from nginx.conf (this reverts the 8d86614
# pid-fix) — the master now writes the default /var/run/nginx.pid
# as root, which is fine because /var/run is root-owned.

COPY nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=build /app/dist /usr/share/nginx/html

# Run as root (default). USER nginx deferred to a follow-up that
# switches to nginxinc/nginx-unprivileged.
# USER nginx

EXPOSE 443
