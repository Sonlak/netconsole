FROM node:22-bookworm-slim AS build

WORKDIR /app

COPY package.json package-lock.json* ./
# Cache mount for npm. See backend/Dockerfile for the rationale.
# On the prod path (`Dockerfile.prod`), this stage runs once per
# `package*.json` change — warm cache saves 20-30s per deploy.
# Requires BuildKit (`DOCKER_BUILDKIT=1`).
RUN --mount=type=cache,target=/root/.npm \
    npm ci

COPY . .
RUN npm run build

FROM nginx:1.27-alpine

# SECURITY (M12, see docs/agents/16-security-audit-preprod.md):
# the default nginx image ships nginx running as root. Running the
# master process as root means a vulnerable route-handler module or
# a writable static file is a privilege-escalation lever. The
# official nginx base image already has an unprivileged `nginx` user.
# We do all root-required setup first, then `USER nginx` at the very
# end of the stage so the runtime process is unprivileged.
#
# Order matters: `apk add` needs root (writable /var/apk and the
# package db), and `chown` is a root-only op. If we `USER nginx`
# before these, they fail with `apk: ERROR: ... exit code: 99` on
# permission denied. The static-dir chown below is also root-only,
# so the order is: chown -> apk/cert -> COPY -> USER nginx.

# Pre-create the static dir as nginx-owned so the COPY below writes
# into a dir the unprivileged runtime can read.
RUN chown -R nginx:nginx /usr/share/nginx/html /etc/nginx/conf.d

# Generate a self-signed cert at build time (1-year expiry,
# 2048-bit RSA, CN=localhost). The image boots out of the box with
# HTTPS support — for PRODUCTION, mount a real cert from
# /etc/letsencrypt/live/<domain>/ over /etc/nginx/certs/ via the
# frontend service's `volumes:` block in docker-compose.app.yml.
# Nginx reads the cert on startup, so a cert-rotation only requires
# `docker compose restart frontend` (no rebuild).
#
# For LOCAL DEV with the same `docker-compose.app.yml` but on a
# developer machine, run `bash frontend/certs/generate_self_signed.sh`
# (or the PowerShell variant) which writes the cert into the same
# frontend/certs/ directory; docker-compose bind-mounts it. The
# self-signed cert generated inside the image below is the same
# shape and same path, so nginx.conf does not need any branch.
#
# Why a self-signed fallback in the image? It means: if the operator
# forgets to mount a real cert, the site still answers HTTPS (with a
# browser warning) instead of returning a connection refused on
# port 443. Strict fail-closed would 503 the entire UI.
#
# `openssl` is not preinstalled in the nginx:alpine image. We install
# it, generate the cert, chown to nginx, and KEEP openssl installed
# in the final image. `apk del openssl` is unsafe: openssl ships
# libssl/libcrypto that nginx itself depends on, so apk refuses with
# "removal of openssl is breaking the world". Cost of leaving it:
# ~3 MB. Benefit: no fragile virtual-package dance.
RUN apk add --no-cache openssl && \
    mkdir -p /etc/nginx/certs && \
    openssl req -x509 -nodes -days 365 -newkey rsa:2048 \
      -keyout /etc/nginx/certs/key.pem \
      -out /etc/nginx/certs/cert.pem \
      -subj "/CN=localhost/O=NetConsole-Image-Fallback" \
      -addext "subjectAltName=DNS:localhost,IP:127.0.0.1" && \
    chown -R nginx:nginx /etc/nginx/certs && \
    chmod 600 /etc/nginx/certs/key.pem /etc/nginx/certs/cert.pem

COPY nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=build /app/dist /usr/share/nginx/html

# Drop root for runtime. Everything below runs as the unprivileged
# `nginx` user. Static files were COPY'd by root above into an
# nginx-owned dir; nginx can read them (dir traversal allowed, files
# are 644).
USER nginx

EXPOSE 443
