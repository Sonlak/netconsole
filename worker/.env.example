# ===========================================
# NetConsole Worker Configuration
# ===========================================
# COPY THIS FILE TO .env AND FILL IN VALUES
# NEVER COMMIT .env TO GIT
# ===========================================

# API Connection
API_BASE_URL=http://localhost:3000/api

# Authentication (get token from backend admin)
# Generate by running: cd ../backend && npm run db:seed
WORKER_AUTH_TOKEN=""

# Polling
POLL_INTERVAL_SECONDS=5

# Worker Identity
WORKER_NAME=netconsole-worker-1
WORKER_CONCURRENCY=4

# Lab SSH (for device simulation)
LAB_SSH_ENABLED=false
LAB_SSH_USER=netconsole
LAB_SSH_PASSWORD=Admin@123
LAB_SSH_PORT=22

# JUNOS REST API (for real Juniper devices)
JUNOS_REST_ENABLED=true
JUNOS_REST_SCHEME=http
JUNOS_REST_PORT=8443
JUNOS_REST_VERIFY_TLS=false
JUNOS_REST_USER=netconsole
JUNOS_REST_PASSWORD=Admin@123
